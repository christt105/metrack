{
  "name": "@metrack/site",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "default": "./dist/markdown/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:assets && tsc -p tsconfig.build.json",
    "build:assets": "node scripts/siteAssets.mjs",
    "check:assets": "node scripts/siteAssets.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@metrack/domain": "0.1.0",
    "@metrack/export": "0.1.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "vite": "^8.3.8"
  }
}
